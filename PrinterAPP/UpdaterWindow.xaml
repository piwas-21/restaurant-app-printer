<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrinterAPP.UpdaterWindow"
             Title="Check for Updates">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- Header -->
            <Label Text="Printer App Updates"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <!-- Current Version -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Current Version" FontSize="14" TextColor="Gray"/>
                    <Label x:Name="CurrentVersionLabel" 
                           Text="Loading..." 
                           FontSize="18" 
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Latest Version -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15" x:Name="LatestVersionFrame" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Latest Version" FontSize="14" TextColor="Gray"/>
                    <Label x:Name="LatestVersionLabel" 
                           Text="-" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="Green"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Release Notes -->
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15" x:Name="ReleaseNotesFrame" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="What's New" FontSize="14" TextColor="Gray"/>
                    <Label x:Name="ReleaseNotesLabel" 
                           Text="-" 
                           FontSize="12"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label x:Name="StatusLabel" 
                   Text="" 
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray"
                   Margin="0,10,0,0"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="DownloadProgressBar" 
                         Progress="0" 
                         IsVisible="False"
                         Margin="0,10,0,0"/>

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button x:Name="CheckButton"
                        Text="Check for Updates"
                        Clicked="OnCheckForUpdatesClicked"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        WidthRequest="150"
                        HeightRequest="45"/>
                
                <Button x:Name="UpdateButton"
                        Text="Update Now"
                        Clicked="OnUpdateNowClicked"
                        BackgroundColor="Green"
                        TextColor="White"
                        WidthRequest="150"
                        HeightRequest="45"
                        IsVisible="False"/>
            </HorizontalStackLayout>

            <!-- Close Button -->
            <Button x:Name="CloseButton"
                    Text="Close"
                    Clicked="OnCloseClicked"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    WidthRequest="100"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
