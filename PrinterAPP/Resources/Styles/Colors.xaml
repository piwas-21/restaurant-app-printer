<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Sofra "craft" palette — food-warm, flat pigment, kitchen/pantry colour names.
         Source of truth: sofra/app/globals.css + sofra/docs/design-tokens.md.
         Paired tokens are consumed via {AppThemeBinding Light={StaticResource X}, Dark={StaticResource XDark}}.
         Values corrected to the real Sofra hex in the branding P0 pass (#71). -->

    <!-- Primary = terracotta / paprika -->
    <Color x:Key="Primary">#a84b2f</Color>
    <Color x:Key="PrimaryDark">#f2b48c</Color>
    <Color x:Key="PrimaryDarkText">#211a16</Color>

    <!-- Secondary = olive branch (text-safe variant for small text on light) -->
    <Color x:Key="Secondary">#7c8450</Color>
    <Color x:Key="SecondaryDark">#b5bc8a</Color>
    <Color x:Key="SecondaryDarkText">#5a6139</Color>

    <!-- Accent = saffron threads (text-safe variant for small text on light) -->
    <Color x:Key="Accent">#d9a441</Color>
    <Color x:Key="AccentDark">#e8c87c</Color>
    <Color x:Key="AccentText">#8a6d2b</Color>

    <Color x:Key="Tertiary">#4c532c</Color>

    <!-- Surfaces — light ("Warm Kitchen") + dark ("Late Evening"; a distinct atmosphere, not an invert). -->
    <Color x:Key="PageBackground">#fff9f2</Color>
    <Color x:Key="PageBackgroundDark">#211a16</Color>
    <Color x:Key="CardBackground">#fffcf8</Color>
    <Color x:Key="CardBackgroundDark">#2c241f</Color>
    <Color x:Key="CardBorder">#eae0d2</Color>
    <Color x:Key="CardBorderDark">#3e3630</Color>
    <Color x:Key="TextPrimary">#3b2e26</Color>
    <Color x:Key="TextPrimaryDark">#f2e9dd</Color>
    <Color x:Key="TextSecondary">#56423d</Color>
    <Color x:Key="TextSecondaryDark">#cbb8b0</Color>
    <Color x:Key="TextMuted">#89726c</Color>
    <Color x:Key="TextMutedDark">#a3908a</Color>

    <!-- Semantic — success (muted moss), warning (saffron), error (soft brick, deliberately pinker than
         the terracotta primary so the two never read as the same colour). Success + warning carry a
         text-safe variant (*Text) for small text on light backgrounds; Sofra defines none for error.
         SuccessDark == Success by design — globals.css uses the same moss in both light and dark. -->
    <Color x:Key="Success">#8cb89a</Color>
    <Color x:Key="SuccessDark">#8cb89a</Color>
    <Color x:Key="SuccessText">#4c7259</Color>
    <Color x:Key="Warning">#d9a441</Color>
    <Color x:Key="WarningDark">#e8c87c</Color>
    <Color x:Key="WarningText">#8a6d2b</Color>
    <Color x:Key="Error">#cc5a50</Color>
    <Color x:Key="ErrorDark">#e8948c</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
