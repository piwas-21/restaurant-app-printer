<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrinterAPP.Pages.PrintStyleSettingsPage"
             Title="Print Style Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- Header with Reset Button -->
            <Border StrokeThickness="0" 
                    Background="{StaticResource Primary}"
                    Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Customize Print Styles" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="Reset to Defaults"
                            Clicked="OnResetClicked"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            Padding="15,8"/>
                </Grid>
            </Border>

            <Label Text="Configure font sizes, styles, and alignment for each section of your receipts."
                   FontSize="14"
                   TextColor="{StaticResource Gray600}"/>

            <!-- Tabs for Kitchen vs Cashier -->
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="10" 
                  Margin="0,10,0,0">
                <Button x:Name="KitchenTabButton"
                        Grid.Column="0"
                        Text="🍳 Kitchen Receipts"
                        Clicked="OnKitchenTabClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"/>
                <Button x:Name="CashierTabButton"
                        Grid.Column="1"
                        Text="💰 Cashier Receipts"
                        Clicked="OnCashierTabClicked"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="{StaticResource Gray900}"/>
            </Grid>

            <!-- Kitchen Settings -->
            <VerticalStackLayout x:Name="KitchenSettings" IsVisible="True" Spacing="15">
                <Label Text="Kitchen Receipt Sections" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       Margin="0,10,0,5"/>

                <!-- Kitchen Header -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Kitchen Header (Front/Back Kitchen)" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenHeaderControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Kitchen Order Info -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Order Info (ID, Date, Type)" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenOrderInfoControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Kitchen Order Type -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Order Type Line" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenOrderTypeControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Kitchen Item Name -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Item Names" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenItemNameControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Kitchen Item Quantity -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Item Quantities" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenItemQuantityControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Kitchen Ingredients -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ingredients &amp; Notes" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="KitchenIngredientsControls"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Cashier Settings -->
            <VerticalStackLayout x:Name="CashierSettings" IsVisible="False" Spacing="15">
                <Label Text="Cashier Receipt Sections" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       Margin="0,10,0,5"/>

                <!-- Cashier Header -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Restaurant Name Header" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="CashierHeaderControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cashier Order Info -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Order Info (ID, Date, Customer)" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="CashierOrderInfoControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cashier Item Lines -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Item Lines" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="CashierItemLineControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cashier Totals -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Subtotal, Tax, Tip" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="CashierTotalsControls"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cashier Grand Total -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Grand Total" 
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Grid x:Name="CashierGrandTotalControls"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Save Button -->
            <Button Text="Save Settings"
                    Clicked="OnSaveClicked"
                    BackgroundColor="{StaticResource Success}"
                    TextColor="White"
                    FontSize="18"
                    Padding="0,15"
                    Margin="0,20,0,0"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
