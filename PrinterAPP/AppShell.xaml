<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PrinterAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PrinterAPP"
    Title="SP-PrinterApp">

    <TabBar>
        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Orders"
            Icon="tab_orders.png"
            ContentTemplate="{DataTemplate local:OrderManagementPage}"
            Route="OrderManagementPage" />

        <ShellContent
            Title="Corrections"
            ContentTemplate="{DataTemplate local:PrinterCorrectionsPage}"
            Route="PrinterCorrectionsPage" />

        <ShellContent
            Title="Diagnostics"
            Icon="tab_diagnostics.png"
            ContentTemplate="{DataTemplate local:DiagnosticsPage}"
            Route="DiagnosticsPage" />
    </TabBar>

</Shell>
