# EditorConfig baseline (DEV-PHASES W1) — https://editorconfig.org
# Style preferences are suggestions only; no analyzer severity tuning here
# (no Roslyn analyzers wired up in this repo yet).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

[*.{xml,csproj,props,targets,xaml,resx,axml}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{sh,ps1}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
