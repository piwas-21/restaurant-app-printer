<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- <Nullable>enable</Nullable> comes from the root Directory.Build.props (solution-wide). -->
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PrinterAPP.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--
    Source-link the cross-platform transport sources rather than ProjectReference-ing the MAUI app
    (which only multi-targets android/windows, not plain net10.0). The transport has no MAUI
    dependency, so it compiles standalone here. Keeps "single repo, no extracted Core library"
    (PRINTER-APP-CROSSPLATFORM-PLAN.md resolved decisions) while making the transport unit-testable
    on any host (macOS/Linux/Windows CI), no emulator/hardware required.
  -->
  <ItemGroup>
    <Compile Include="..\PrinterAPP\Services\IPrinterTransport.cs" Link="Linked\IPrinterTransport.cs" />
    <Compile Include="..\PrinterAPP\Services\NetworkTcpTransport.cs" Link="Linked\NetworkTcpTransport.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterEndpoint.cs" Link="Linked\PrinterEndpoint.cs" />
    <!-- Test-print routing seam (spooler test-print transport migration; ADR-006 Phase 2b).
         WindowsSpoolerTransport compiles here without the WINDOWS symbol, i.e. as its
         cross-platform stub surface — the P/Invoke body only compiles in the Windows TFM. -->
    <Compile Include="..\PrinterAPP\Services\EscPosCommands.cs" Link="Linked\EscPosCommands.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterService.cs" Link="Linked\IPrinterService.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterTestService.cs" Link="Linked\IPrinterTestService.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTestService.cs" Link="Linked\PrinterTestService.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTestTarget.cs" Link="Linked\PrinterTestTarget.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTransportKind.cs" Link="Linked\PrinterTransportKind.cs" />
    <Compile Include="..\PrinterAPP\Services\WindowsSpoolerTransport.cs" Link="Linked\WindowsSpoolerTransport.cs" />
    <!-- Order-print routing seam (OrderPrintService spooler transport migration; ADR-006 Phase 2b). -->
    <Compile Include="..\PrinterAPP\Services\PrinterTransportResolver.cs" Link="Linked\PrinterTransportResolver.cs" />
    <!-- Order models (MAUI-free; plain System.Text.Json records). Pinned here to guard the
         backend-DTO mirror after a string-vs-object drift on deliveryAddress wedged the prod poll. -->
    <Compile Include="..\PrinterAPP\Models\Order.cs" Link="Linked\Order.cs" />
    <Compile Include="..\PrinterAPP\Models\DeliveryAddress.cs" Link="Linked\DeliveryAddress.cs" />
    <!-- Resilient per-order feed parser (MAUI-free): one bad order must not wedge the whole poll batch. -->
    <Compile Include="..\PrinterAPP\Services\OrderFeedParser.cs" Link="Linked\OrderFeedParser.cs" />
    <!-- Config storage + migration (MAUI-free by design; see PrinterConfigurationStore.cs). -->
    <Compile Include="..\PrinterAPP\Models\PrinterConfiguration.cs" Link="Linked\PrinterConfiguration.cs" />
    <Compile Include="..\PrinterAPP\Services\IAppDataPathProvider.cs" Link="Linked\IAppDataPathProvider.cs" />
    <Compile Include="..\PrinterAPP\Services\ISecretStore.cs" Link="Linked\ISecretStore.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterConfigurationStore.cs" Link="Linked\IPrinterConfigurationStore.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterConfigurationStore.cs" Link="Linked\PrinterConfigurationStore.cs" />
    <Compile Include="..\PrinterAPP\Services\LegacyAppDataMigration.cs" Link="Linked\LegacyAppDataMigration.cs" />
  </ItemGroup>

</Project>
