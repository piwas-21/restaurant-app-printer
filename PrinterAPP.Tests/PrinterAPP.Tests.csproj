<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- <Nullable>enable</Nullable> comes from the root Directory.Build.props (solution-wide). -->
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PrinterAPP.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--
    Source-link the cross-platform transport sources rather than ProjectReference-ing the MAUI app
    (which only multi-targets android/windows, not plain net10.0). The transport has no MAUI
    dependency, so it compiles standalone here. Keeps "single repo, no extracted Core library"
    (PRINTER-APP-CROSSPLATFORM-PLAN.md resolved decisions) while making the transport unit-testable
    on any host (macOS/Linux/Windows CI), no emulator/hardware required.
  -->
  <ItemGroup>
    <Compile Include="..\PrinterAPP\Services\IPrinterTransport.cs" Link="Linked\IPrinterTransport.cs" />
    <Compile Include="..\PrinterAPP\Services\NetworkTcpTransport.cs" Link="Linked\NetworkTcpTransport.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterEndpoint.cs" Link="Linked\PrinterEndpoint.cs" />
    <!-- Test-print routing seam (spooler test-print transport migration; ADR-006 Phase 2b).
         WindowsSpoolerTransport compiles here without the WINDOWS symbol, i.e. as its
         cross-platform stub surface — the P/Invoke body only compiles in the Windows TFM. -->
    <Compile Include="..\PrinterAPP\Services\EscPosCommands.cs" Link="Linked\EscPosCommands.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterService.cs" Link="Linked\IPrinterService.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterTestService.cs" Link="Linked\IPrinterTestService.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTestService.cs" Link="Linked\PrinterTestService.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTestTarget.cs" Link="Linked\PrinterTestTarget.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTransportKind.cs" Link="Linked\PrinterTransportKind.cs" />
    <Compile Include="..\PrinterAPP\Services\WindowsSpoolerTransport.cs" Link="Linked\WindowsSpoolerTransport.cs" />
    <!-- Order-print routing seam (OrderPrintService spooler transport migration; ADR-006 Phase 2b). -->
    <Compile Include="..\PrinterAPP\Services\PrinterTransportResolver.cs" Link="Linked\PrinterTransportResolver.cs" />
    <!-- Order models (MAUI-free; plain System.Text.Json records). Pinned here to guard the
         backend-DTO mirror after a string-vs-object drift on deliveryAddress wedged the prod poll. -->
    <Compile Include="..\PrinterAPP\Models\Order.cs" Link="Linked\Order.cs" />
    <Compile Include="..\PrinterAPP\Models\DeliveryAddress.cs" Link="Linked\DeliveryAddress.cs" />
    <!-- Resilient per-order feed parser (MAUI-free): one bad order must not wedge the whole poll batch. -->
    <Compile Include="..\PrinterAPP\Services\OrderFeedParser.cs" Link="Linked\OrderFeedParser.cs" />
    <!-- Config storage + migration (MAUI-free by design; see PrinterConfigurationStore.cs). -->
    <Compile Include="..\PrinterAPP\Models\PrinterConfiguration.cs" Link="Linked\PrinterConfiguration.cs" />
    <Compile Include="..\PrinterAPP\Services\IAppDataPathProvider.cs" Link="Linked\IAppDataPathProvider.cs" />
    <Compile Include="..\PrinterAPP\Services\ISecretStore.cs" Link="Linked\ISecretStore.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrinterConfigurationStore.cs" Link="Linked\IPrinterConfigurationStore.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterConfigurationStore.cs" Link="Linked\PrinterConfigurationStore.cs" />
    <!-- Feed cursor persistence (MAUI-free by design, same as the config store): stops a process
         restart reprinting the last 30 minutes of orders. -->
    <Compile Include="..\PrinterAPP\Models\FeedCursor.cs" Link="Linked\FeedCursor.cs" />
    <Compile Include="..\PrinterAPP\Services\IFeedCursorStore.cs" Link="Linked\IFeedCursorStore.cs" />
    <Compile Include="..\PrinterAPP\Services\FeedCursorStore.cs" Link="Linked\FeedCursorStore.cs" />
    <Compile Include="..\PrinterAPP\Services\LegacyAppDataMigration.cs" Link="Linked\LegacyAppDataMigration.cs" />
    <!-- Fleet telemetry (MAUI-free): the HTTP client + pure payload builder + request model.
         The scheduler + MAUI wiring stay in the app head; the risk-bearing HTTP/payload logic is
         unit-tested here (headers, URL, error handling, and the "no API key in the body" contract). -->
    <Compile Include="..\PrinterAPP\Models\HeartbeatRequest.cs" Link="Linked\HeartbeatRequest.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintAck.cs" Link="Linked\PrintAck.cs" />
    <Compile Include="..\PrinterAPP\Models\DevicePrintTarget.cs" Link="Linked\DevicePrintTarget.cs" />
    <Compile Include="..\PrinterAPP\Models\DevicePrintStatus.cs" Link="Linked\DevicePrintStatus.cs" />
    <Compile Include="..\PrinterAPP\Services\ITelemetryClient.cs" Link="Linked\ITelemetryClient.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetryClient.cs" Link="Linked\TelemetryClient.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetrySendResult.cs" Link="Linked\TelemetrySendResult.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetryPayloads.cs" Link="Linked\TelemetryPayloads.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrintAckOutbox.cs" Link="Linked\IPrintAckOutbox.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintAckOutbox.cs" Link="Linked\PrintAckOutbox.cs" />
    <!-- Order-print composition (MAUI-free after the PrintStyleSettingsService path-provider seam): the
         real ESC/POS receipt builder, driven to a loopback TcpListener for the print-to-sink test. Pulls
         in the request-log boundary (MAUI-free since the LogEntry extraction). -->
    <Compile Include="..\PrinterAPP\Services\IOrderPrintService.cs" Link="Linked\IOrderPrintService.cs" />
    <Compile Include="..\PrinterAPP\Services\OrderPrintService.cs" Link="Linked\OrderPrintService.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintStyleSettingsService.cs" Link="Linked\PrintStyleSettingsService.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintStyleSettings.cs" Link="Linked\PrintStyleSettings.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterType.cs" Link="Linked\PrinterType.cs" />
    <Compile Include="..\PrinterAPP\Services\IRequestLogService.cs" Link="Linked\IRequestLogService.cs" />
    <Compile Include="..\PrinterAPP\Services\LogEntry.cs" Link="Linked\LogEntry.cs" />
    <!-- The order feed itself (MAUI-free and deliberately Sentry-free so it links here). Pinned to
         cover the IsListening state machine: a loop that ends must never leave the feed claiming to
         listen, or every restart path early-returns and the feed is unrecoverable. See ADR-007. -->
    <Compile Include="..\PrinterAPP\Services\IEventStreamingService.cs" Link="Linked\IEventStreamingService.cs" />
    <Compile Include="..\PrinterAPP\Services\EventStreamingService.cs" Link="Linked\EventStreamingService.cs" />
    <!-- Watchdog decision rules, extracted pure so they are testable without the pipeline's
         collaborators (nor MAUI/Sentry). Auto-restarting a live feed must not misfire. -->
    <Compile Include="..\PrinterAPP\Services\FeedWatchdogDecision.cs" Link="Linked\FeedWatchdogDecision.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
