<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PrinterAPP.E2E</RootNamespace>
    <!-- Opt-in E2E suite: excluded from the default `dotnet test PrinterAPP.Tests` CI job (it needs a
         live backend). Run via .github/workflows/e2e.yml (schedule / workflow_dispatch) or locally
         with PRINTERAPP_E2E_* env vars pointed at a backend. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!--
    Source-link the REAL production services (MAUI-free at source) + their models, exactly like
    PrinterAPP.Tests does — the suite exercises the shipping code, never a re-implementation. See
    docs/E2E-STRATEGY.md ("No mocks of our own code").
  -->
  <ItemGroup>
    <!-- Models (MAUI-free; also linked by PrinterAPP.Tests). Order/DeliveryAddress are needed because
         TelemetryPayloads.PrintAcks(Order, ...) references them. -->
    <Compile Include="..\PrinterAPP\Models\Order.cs" Link="Linked\Order.cs" />
    <Compile Include="..\PrinterAPP\Models\OrderPresentationMetadata.cs" Link="Linked\OrderPresentationMetadata.cs" />
    <Compile Include="..\PrinterAPP\Models\OrderAmendmentPrintContext.cs" Link="Linked\OrderAmendmentPrintContext.cs" />
    <Compile Include="..\PrinterAPP\Models\ExternalOrder.cs" Link="Linked\ExternalOrder.cs" />
    <Compile Include="..\PrinterAPP\Models\TableDisplay.cs" Link="Linked\TableDisplay.cs" />
    <Compile Include="..\PrinterAPP\Models\DeliveryAddress.cs" Link="Linked\DeliveryAddress.cs" />
    <Compile Include="..\PrinterAPP\Models\OrderRoutingState.cs" Link="Linked\OrderRoutingState.cs" />
    <Compile Include="..\PrinterAPP\Models\PrinterConfiguration.cs" Link="Linked\PrinterConfiguration.cs" />
    <!-- PrinterConfiguration.PrintLanguage references PrintLanguagePolicy.English; the policy is
         MAUI-free, so the link keeps this compile-only guard green. -->
    <Compile Include="..\PrinterAPP\Services\PrintLanguagePolicy.cs" Link="Linked\PrintLanguagePolicy.cs" />
    <Compile Include="..\PrinterAPP\Services\KitchenRoutingPolicy.cs" Link="Linked\KitchenRoutingPolicy.cs" />
    <Compile Include="..\PrinterAPP\Services\KitchenDestinationResolver.cs" Link="Linked\KitchenDestinationResolver.cs" />
    <Compile Include="..\PrinterAPP\Services\EscPosCommands.cs" Link="Linked\EscPosCommands.cs" />
    <Compile Include="..\PrinterAPP\Models\HeartbeatRequest.cs" Link="Linked\HeartbeatRequest.cs" />
    <Compile Include="..\PrinterAPP\Models\PrinterTargetCapability.cs" Link="Linked\PrinterTargetCapability.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintAck.cs" Link="Linked\PrintAck.cs" />
    <Compile Include="..\PrinterAPP\Models\DevicePrintTarget.cs" Link="Linked\DevicePrintTarget.cs" />
    <Compile Include="..\PrinterAPP\Models\DevicePrintStatus.cs" Link="Linked\DevicePrintStatus.cs" />
    <Compile Include="..\PrinterAPP\Models\DevicePrintJobType.cs" Link="Linked\DevicePrintJobType.cs" />
    <Compile Include="..\PrinterAPP\Models\PrinterFeedUpdate.cs" Link="Linked\PrinterFeedUpdate.cs" />
    <Compile Include="..\PrinterAPP\Models\PrinterFeedChange.cs" Link="Linked\PrinterFeedChange.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintStyleSettings.cs" Link="Linked\PrintStyleSettings.cs" />
    <Compile Include="..\PrinterAPP\Models\PaymentMethodCode.cs" Link="Linked\PaymentMethodCode.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintUpdateJobState.cs" Link="Linked\PrintUpdateJobState.cs" />
    <Compile Include="..\PrinterAPP\Models\PrintUpdateJobRecord.cs" Link="Linked\PrintUpdateJobRecord.cs" />
    <!-- Fleet telemetry client (the real shipping services under test) -->
    <Compile Include="..\PrinterAPP\Services\ITelemetryClient.cs" Link="Linked\ITelemetryClient.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetryClient.cs" Link="Linked\TelemetryClient.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetrySendResult.cs" Link="Linked\TelemetrySendResult.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetryPayloads.cs" Link="Linked\TelemetryPayloads.cs" />
    <Compile Include="..\PrinterAPP\Services\TelemetryPayloads.Routing.cs" Link="Linked\TelemetryPayloads.Routing.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterTargetCapabilityBuilder.cs" Link="Linked\PrinterTargetCapabilityBuilder.cs" />
    <Compile Include="..\PrinterAPP\Services\KitchenPrintOutcome.cs" Link="Linked\KitchenPrintOutcome.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrintAckOutbox.cs" Link="Linked\IPrintAckOutbox.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintAckOutbox.cs" Link="Linked\PrintAckOutbox.cs" />
    <Compile Include="..\PrinterAPP\Services\IPrintUpdateJobStore.cs" Link="Linked\IPrintUpdateJobStore.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintUpdateJobStore.cs" Link="Linked\PrintUpdateJobStore.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintUpdateJobStore.Retention.cs" Link="Linked\PrintUpdateJobStore.Retention.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintUpdateJobStore.Withdrawal.cs" Link="Linked\PrintUpdateJobStore.Withdrawal.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterUpdateWithdrawalRedactor.cs" Link="Linked\PrinterUpdateWithdrawalRedactor.cs" />
    <Compile Include="..\PrinterAPP\Services\IAppDataPathProvider.cs" Link="Linked\IAppDataPathProvider.cs" />
    <!-- Request-log boundary, now MAUI-free (A0): the LogType→Color map moved to a UI converter, so the
         interface + LogEntry source-link into net10.0. This unblocks source-linking EventStreamingService
         (the order-feed E2E, A1) which depends on IRequestLogService. See docs/E2E-STRATEGY.md. -->
    <Compile Include="..\PrinterAPP\Services\IRequestLogService.cs" Link="Linked\IRequestLogService.cs" />
    <Compile Include="..\PrinterAPP\Services\LogEntry.cs" Link="Linked\LogEntry.cs" />
    <!-- Order-feed service (A1): the REAL polling loop under test. IPrinterService is the config-source
         edge (a test double returns the PrinterConfiguration a user would type into Settings);
         OrderFeedParser is the real per-order deser (also linked by PrinterAPP.Tests). -->
    <Compile Include="..\PrinterAPP\Services\IPrinterService.cs" Link="Linked\IPrinterService.cs" />
    <Compile Include="..\PrinterAPP\Services\IDeviceIdentityService.cs" Link="Linked\IDeviceIdentityService.cs" />
    <Compile Include="..\PrinterAPP\Services\IEventStreamingService.cs" Link="Linked\IEventStreamingService.cs" />
    <!-- Feed cursor persistence: EventStreamingService restores its poll cursor + dedup set from
         this on construction, so the E2E head must link it too (Phase 9d). -->
    <Compile Include="..\PrinterAPP\Models\FeedCursor.cs" Link="Linked\FeedCursor.cs" />
    <Compile Include="..\PrinterAPP\Services\IFeedCursorStore.cs" Link="Linked\IFeedCursorStore.cs" />
    <Compile Include="..\PrinterAPP\Services\FeedCursorStore.cs" Link="Linked\FeedCursorStore.cs" />
    <Compile Include="..\PrinterAPP\Services\UpdateJobRouting.cs" Link="Linked\UpdateJobRouting.cs" />
    <Compile Include="..\PrinterAPP\Services\UpdateReceiptComposer.cs" Link="Linked\UpdateReceiptComposer.cs" />
    <Compile Include="..\PrinterAPP\Services\PrintLabels.cs" Link="Linked\PrintLabels.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptComposer.cs" Link="Linked\ReceiptComposer.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptComposer.Composition.cs" Link="Linked\ReceiptComposer.Composition.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptComponentFormatting.cs" Link="Linked\ReceiptComponentFormatting.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptKitchenLineFormatter.cs" Link="Linked\ReceiptKitchenLineFormatter.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptCompositionProjection.cs" Link="Linked\ReceiptCompositionProjection.cs" />
    <Compile Include="..\PrinterAPP\Services\CashierPaymentPresentation.cs" Link="Linked\CashierPaymentPresentation.cs" />
    <Compile Include="..\PrinterAPP\Services\ReceiptItemDisplay.cs" Link="Linked\ReceiptItemDisplay.cs" />
    <Compile Include="..\PrinterAPP\Services\UnconfirmedOrderExpiry.cs" Link="Linked\UnconfirmedOrderExpiry.cs" />
    <Compile Include="..\PrinterAPP\Services\EventStreamingService.cs" Link="Linked\EventStreamingService.cs" />
    <Compile Include="..\PrinterAPP\Services\OrderFeedParser.cs" Link="Linked\OrderFeedParser.cs" />
    <Compile Include="..\PrinterAPP\Services\OrderFeedParser.Orders.cs" Link="Linked\OrderFeedParser.Orders.cs" />
    <Compile Include="..\PrinterAPP\Services\OrderPresentationMetadataNormalizer.cs" Link="Linked\OrderPresentationMetadataNormalizer.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterFeedUpdateValidation.cs" Link="Linked\PrinterFeedUpdateValidation.cs" />
    <Compile Include="..\PrinterAPP\Services\OrderRoutingStateValidation.cs" Link="Linked\OrderRoutingStateValidation.cs" />
    <Compile Include="..\PrinterAPP\Services\PrinterJsonSerialization.cs" Link="Linked\PrinterJsonSerialization.cs" />
  </ItemGroup>

</Project>
